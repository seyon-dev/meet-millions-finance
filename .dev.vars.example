# =============================================================================
# Meet Millions Finance CRM — environment template
# =============================================================================
# Copy to `.dev.vars` for local `wrangler dev`, and register each value in
# production with:  wrangler secret put <NAME>
#
# NEVER commit real values. This file contains placeholders only.
# Every integration below degrades gracefully to "Not Connected" when its
# credentials are absent — the CRM core keeps working without any of them.
# =============================================================================

# ---- Platform (required) ----------------------------------------------------
# 32+ random bytes, base64. Signs session tokens and CSRF tokens.
#   openssl rand -base64 48
AUTH_SECRET=replace-with-openssl-rand-base64-48
# Encrypts TOTP seeds and integration credentials stored in D1.
ENCRYPTION_KEY=replace-with-openssl-rand-base64-32
# Signs private R2 document download URLs.
FILE_SIGNING_SECRET=replace-with-openssl-rand-base64-32

# ---- First platform Super Admin (optional, first boot only) -----------------
# There is deliberately no default password. Set these two before the first
# request, and bootstrap creates the one platform Super Admin, forced to change
# its password at first sign-in. Once that account exists these are ignored, so
# clear them again afterwards. A password shorter than 12 characters is refused
# and no account is created.
PLATFORM_OWNER_EMAIL=
PLATFORM_OWNER_PASSWORD=
PLATFORM_OWNER_NAME=Platform Owner

# ---- Node.js runtime (Hostinger) -------------------------------------------
# Hostinger sets PORT itself; the app reads it and falls back to 3000 locally.
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# The origin this application is served from. OAuth redirect URIs, e-mail
# links and white-label instructions are built from it, so a wrong value
# breaks every OAuth flow. No default: set it to your real domain.
APP_URL=

# ---- MySQL (Hostinger) -----------------------------------------------------
# From hPanel → Databases → Management. The app refuses to start if any of
# these four are missing, and says which.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
# Connections held open. Hostinger caps concurrent connections per database;
# 10 is comfortable for one Node process.
DB_POOL_SIZE=10

# ---- Document storage ------------------------------------------------------
# An absolute path OUTSIDE the application directory. Everything a client
# uploads lives here. The server refuses to start if this sits inside the
# directory it publishes, because every document would then be downloadable
# without signing in.
STORAGE_ROOT=/home/USERNAME/mm-storage

# ---- Database migration ----------------------------------------------------
# When true, the application applies any missing database schema before it
# starts listening. For managed hosting with no shell access. Guarded by the
# record of applied migrations, so a restart does not re-apply anything.
# Run ONE instance with this on. Default false.
AUTO_MIGRATE=false

# How many proxies sit in front of this process. Hostinger's managed Node.js
# is one hop; put a CDN in front later and it becomes two. This is what makes
# the client address the application rate-limits and audits a real one.
TRUST_PROXY_HOPS=1

# The largest request body the server accepts, in bytes. 52428800 (50MB) sits
# just above the 50MB document upload limit; anything larger is refused with
# a 413 before it can occupy memory.
MAX_BODY_BYTES=52428800

# ---- Demonstration data (optional) -----------------------------------------
# SEED_DEMO=true creates an invented practice — five client companies, a month
# of documents — at startup, for managed hosting where `npm run seed` cannot be
# run. It writes once; a restart finds it and does nothing. Turn it off again
# once you have signed in.
#
# DEMO_PASSWORD is the password every demonstration account gets. Unset, the
# seed falls back to one committed to this repository, and seeding a production
# database is refused for that reason — the set includes a Super Admin who can
# see every organisation. SEED_DEMO_ACCEPT_RISK=true overrides that refusal.
SEED_DEMO=false
# DEMO_PASSWORD=
# SEED_DEMO_ACCEPT_RISK=false

# ---- Scheduled jobs --------------------------------------------------------
# The three cron schedules run inside the Node process. Set to false on any
# additional instance, or the jobs run twice.
RUN_SCHEDULER=true
CRON_TIMEZONE=UTC

# ---- Runtime configuration (optional; wrangler.jsonc `vars` sets these in
# ---- production, so they are only needed for local `wrangler dev`) ----------
# Origin this Worker is served from. OAuth redirect URIs and e-mail links are
# built from it, so a wrong value breaks every OAuth flow.
APP_URL=http://localhost:8787
APP_NAME=Meet Millions Finance CRM
APP_ENV=development
# Shows the demonstration banner and allows demo seeding. Never "true" in
# production.
DEMO_MODE=true
# Extra origins allowed to call the API, comma separated. Same-origin needs
# nothing here; this is for the white-label custom-domain case and the public
# API. "*" allows any origin — do not use it in production.
CORS_ORIGINS=
# Deployment-wide inactivity cut-off, in minutes (0 disables it). Each
# organisation also has its own idle timeout in Settings -> Security;
# whichever of the two is stricter signs an idle session out.
IDLE_TIMEOUT_MINUTES=60
# How long the tamper-evident audit trail and backups are kept. 2555 days is
# seven years, which is the Indian statutory retention period.
AUDIT_RETENTION_DAYS=2555
BACKUP_RETENTION_DAYS=365
# Upload ceiling and the MIME allow-list. The extension deny-list in
# src/services/storage.js applies regardless of what is set here.
UPLOAD_MAX_BYTES=52428800
UPLOAD_ALLOWED_MIME=

# ---- Upload scanning (optional but strongly recommended) -------------------
# Any HTTP service that accepts raw bytes on POST <url>/scan and answers
# {"infected": true|false, "viruses": [...]} or ClamAV's textual OK / FOUND.
# clamav-rest in front of clamd is the usual deployment.
#
# With nothing set here, uploads are stored with scan_status = "skipped",
# which is the truth. They are NOT recorded as clean.
VIRUS_SCAN_URL=
# Sent as `Authorization: Bearer <token>` when present. Leave empty only if
# the scanner is reachable exclusively from this Worker.
VIRUS_SCAN_TOKEN=
# Milliseconds to wait before giving up. A timeout records "failed", never
# "clean". Default 20000.
VIRUS_SCAN_TIMEOUT_MS=20000

# ---- Email — Amazon SES (Integration Stack: transactional & reports) --------
SES_REGION=ap-south-1
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
SES_FROM_ADDRESS=no-reply@meetmillionscrm.in
SES_FROM_NAME=Meet Millions Finance CRM

# ---- SMS — MSG91 (DLT registered, India) -----------------------------------
MSG91_AUTH_KEY=
MSG91_SENDER_ID=MMFCRM
MSG91_ROUTE=4
MSG91_DLT_TE_ID=

# ---- WhatsApp — Meta WhatsApp Cloud API ------------------------------------
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ---- Push — Firebase Cloud Messaging (mobile app) --------------------------
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# ---- Meta Lead Ads — Graph API ---------------------------------------------
META_APP_ID=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
META_LEADGEN_VERIFY_TOKEN=

# ---- Google (Sheets / Forms / Drive / Calendar / Vision / Speech) ----------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_VISION_API_KEY=
GOOGLE_SPEECH_API_KEY=

# ---- Microsoft (OneDrive / SharePoint / Outlook Calendar) ------------------
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_TENANT_ID=

# ---- Dropbox ----------------------------------------------------------------
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=

# ---- LLM — Claude API (Anthropic): GST assistant, insights, call AI --------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ---- Payments ---------------------------------------------------------------
# Razorpay is the Integration Stack default (UPI, cards, net banking).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional alternate gateways — the provider abstraction supports all four.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Public by design: the browser needs it to build the payment form.
STRIPE_PUBLISHABLE_KEY=
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_SECRET=
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=1

# ---- e-Sign — Digio / Leegality (Aadhaar e-Sign + DSC) ---------------------
DIGIO_CLIENT_ID=
DIGIO_CLIENT_SECRET=
LEEGALITY_AUTH_TOKEN=
ESIGN_WEBHOOK_SECRET=

# ---- Cloud Telephony — Exotel default; 7 providers supported ---------------
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_CALLER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_CALLER_ID=
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_CALLER_ID=
KNOWLARITY_API_KEY=
KNOWLARITY_SR_NUMBER=
MYOPERATOR_API_KEY=
MYOPERATOR_COMPANY_ID=
RINGCENTRAL_CLIENT_ID=
RINGCENTRAL_CLIENT_SECRET=
RINGCENTRAL_JWT=
AIRCALL_API_ID=
AIRCALL_API_TOKEN=
# Provider-specific extras, only needed for those providers.
# MyOperator: the public IVR number leads are routed through.
MYOPERATOR_PUBLIC_IVR=
# RingCentral: the API host, e.g. https://platform.ringcentral.com
RINGCENTRAL_SERVER=
TELEPHONY_WEBHOOK_SECRET=

# ---- White Label — Cloudflare API for custom domain automation -------------
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
